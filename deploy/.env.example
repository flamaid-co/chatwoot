# FlamAid · Chatwoot environment template
# Copy to `.env` (same folder) and fill in. NEVER commit the real .env.
#   cp .env.example .env
#
# Generate secrets:
#   SECRET_KEY_BASE   ->  openssl rand -hex 64
#   POSTGRES_PASSWORD ->  openssl rand -hex 24
#   REDIS_PASSWORD    ->  openssl rand -hex 24
# REDIS_URL must embed the same REDIS_PASSWORD: redis://:<password>@redis:6379

# --- Core ---
SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Public URL of the app.
#  - Phase A (SSH tunnel, viewing only): http://localhost:3000
#  - Phase B (public):                   https://support.flamaid.com
FRONTEND_URL=https://support.flamaid.com

# Open signup disabled — users are created by an admin.
ENABLE_ACCOUNT_SIGNUP=false

# Default UI locale (es / en / pt ...)
DEFAULT_LOCALE=es

# --- Postgres (internal network only) ---
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_24

# --- Redis (internal network only) ---
REDIS_URL=redis://:replace_with_redis_password@redis:6379
REDIS_PASSWORD=replace_with_openssl_rand_hex_24

# --- Outbound email (fill when ready; needed for invites, password resets,
#     and email-channel replies). Use the FlamAid SMTP / provider creds. ---
# MAILER_SENDER_EMAIL=FlamAid <support@flamaid.com>
# SMTP_DOMAIN=flamaid.com
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=login
# SMTP_ENABLE_STARTTLS_AUTO=true
